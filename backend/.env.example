# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/edupay?schema=public"

# ─── App ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── JWT (OBLIGATORIO — no existe fallback; mínimo 32 caracteres aleatorios) ──
JWT_SECRET="CHANGE_ME_a_random_secret_key_min_32_chars"

# ─── Portal de Pagos (Server-to-Server) ──────────────────────
# Mapa JSON tenantId -> Bearer Token configurado en el BFF por colegio.
PORTAL_TENANT_KEYS='{"colegio-conquistadores":"CHANGE_ME_portal_key_1","colegio-pruebas":"CHANGE_ME_portal_key_2"}'

# Outbound guardian email webhooks. Secrets must have at least 32 characters.
# HTTPS is mandatory in production. Keep this value in the platform secret store.
GUARDIAN_EMAIL_WEBHOOKS='{"colegio-conquistadores":{"url":"https://portal.tu-dominio.cl/api/webhooks/edupay/guardian-email","secret":"CHANGE_ME_random_hmac_secret_min_32_chars"}}'
GUARDIAN_EMAIL_WEBHOOK_MAX_ATTEMPTS=8
GUARDIAN_EMAIL_WEBHOOK_RETRY_BASE_SECONDS=60
GUARDIAN_EMAIL_WEBHOOK_TIMEOUT_MS=10000
GUARDIAN_EMAIL_WEBHOOK_BATCH_SIZE=20

# ─── CORS (OBLIGATORIO) ──────────────────────────────────────
# Solo se admiten los orígenes configurados para el Portal. Puede usar una
# u otra variable; si configura ambas, ambas direcciones quedan permitidas.
PORTAL_URL="https://portal.tu-dominio.cl"
NEXT_PUBLIC_APP_URL="https://portal.tu-dominio.cl"

# ─── Email ───────────────────────────────────────────────────
# Pon ENABLE_EMAILS=true solo cuando tengas SMTP configurado.
# Con false (por defecto) los correos se simulan en consola: Zero-Cost Mode.
ENABLE_EMAILS=false

SMTP_HOST="smtp.ejemplo.cl"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@colegio.cl"

# ─── Upload ──────────────────────────────────────────────────
# Ruta relativa al cwd del proceso. En Docker el volumen se monta en /usr/src/app/uploads.
UPLOAD_DIR="uploads"
