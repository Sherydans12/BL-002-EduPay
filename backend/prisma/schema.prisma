// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────
enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  CHECK
  TRANSFER
  WEBPAY
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum ChargeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentSource {
  MANUAL
  PORTAL
}

enum FinancialSetupStatus {
  PENDING
  CONFIGURED
}

/// Lifecycle of an academic year, mirrored from Académico (ADR-0025).
enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  BOLETA_DELIVERY
  PAYMENT_RECEIPT
  COBRANZA_PREVENTIVA
  COBRANZA_MORA
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum CommunicationType {
  BOLETA_EMITTED
  MANUAL_PAYMENT_RECEIPT
  PAYMENT_REMINDER
  ACCOUNT_STATEMENT
}

enum DeliveryStatus {
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

enum AcademicFinancialProjectionOperation {
  UPSERT
  TOMBSTONE
}

enum AcademicFinancialProjectionEventOutcome {
  APPLIED
  DUPLICATE
  STALE
  REJECTED
  QUARANTINED
}

enum AcademicFinancialProjectionSnapshotStatus {
  STARTED
  INCOMPLETE
  COMPLETE
  RECONCILED
  FAILED
}

// ─── Models ──────────────────────────────────────────────────

model Tenant {
  id                 String                  @id
  name               String
  slug               String                  @unique
  isActive           Boolean                 @default(true)
  academicYears      AcademicYear[]
  courses            Course[]
  enrollments        Enrollment[]
  guardians          Guardian[]
  students           Student[]
  paymentConcepts    PaymentConcept[]
  paymentGroups      PaymentGroup[]
  payments           Payment[]
  charges            Charge[]
  notificationLogs   NotificationLog[]
  sentCommunications SentCommunication[]
  emailConfig        TenantEmailConfig?
  canonicalMapping   TenantCanonicalMapping?
  academicFinancialProjections AcademicFinancialProjection[]
  academicFinancialProjectionEvents AcademicFinancialProjectionConsumedEvent[]
  academicFinancialProjectionSnapshots AcademicFinancialProjectionSnapshot[]
  users              User[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@map("tenants")
}

model Course {
  id                         Int       @id @default(autoincrement())
  integrationId              String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integrationCreatedSequence BigInt    @default(dbgenerated("nextval('integration_change_sequence'::regclass)"))
  integrationVersion         BigInt    @default(dbgenerated("nextval('integration_change_sequence'::regclass)"))
  tenantId                   String    @default("colegio-conquistadores")
  tenant                     Tenant    @relation(fields: [tenantId], references: [id])
  name                       String
  /// Académico Course.id once the projection writer links or creates it.
  canonicalCourseId          String?   @db.Uuid
  /// Each course belongs to one academic year: "1° Básico A" 2026 and 2027
  /// are different courses (ADR-0025).
  academicYearId             Int
  academicYear               AcademicYear @relation(fields: [academicYearId], references: [id])
  students                   Student[]
  enrollments                Enrollment[]
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  @@unique([tenantId, academicYearId, name])
  @@unique([tenantId, canonicalCourseId])
  @@index([academicYearId])
  @@index([tenantId])
  @@index([tenantId, integrationVersion, integrationId])
  @@index([tenantId, integrationCreatedSequence, integrationId])
  @@map("courses")
}

model Guardian {
  id            Int       @id @default(autoincrement())
  tenantId      String    @default("colegio-conquistadores")
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  rut           String?
  /**
   * Derivado en BD para búsqueda sin puntos/guiones
   */
  rutNormalized String?   @default(dbgenerated()) @map("rut_normalized")
  name          String
  email         String?
  phone         String?
  students      Student[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@unique([tenantId, rut])
  @@index([tenantId])
  @@map("guardians")
}

model Student {
  id                         Int                  @id @default(autoincrement())
  integrationId              String               @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integrationCreatedSequence BigInt               @default(dbgenerated("nextval('integration_change_sequence'::regclass)"))
  integrationVersion         BigInt               @default(dbgenerated("nextval('integration_change_sequence'::regclass)"))
  tenantId                   String               @default("colegio-conquistadores")
  tenant                     Tenant               @relation(fields: [tenantId], references: [id])
  rut                        String
  /**
   * Derivado en BD para búsqueda sin puntos/guiones
   */
  rutNormalized              String?              @default(dbgenerated()) @map("rut_normalized")
  /// `RUN` or `IPE` when the student came from Académico; null for legacy rows
  /// (their `rut` is a RUN).
  nationalIdType             String?              @db.VarChar(8)
  /// Académico Student.id once the projection writer links or creates it.
  canonicalStudentId         String?              @db.Uuid
  name                       String
  firstName                  String?
  lastName                   String?
  status                     StudentStatus        @default(ACTIVE)
  /// Transitional mirror of the ACTIVE academic year's enrollment. Billing
  /// reads and writes Enrollment.financialSetup; this field follows it.
  financialSetup             FinancialSetupStatus @default(PENDING)
  /// Transitional mirror of the ACTIVE academic year's enrollment course.
  courseId                   Int
  guardianId                 Int
  course                     Course               @relation(fields: [courseId], references: [id])
  guardian                   Guardian             @relation(fields: [guardianId], references: [id])
  payments                   Payment[]
  charges                    Charge[]
  enrollments                Enrollment[]
  notificationLogs           NotificationLog[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  deletedAt                  DateTime?

  @@unique([tenantId, rut])
  @@unique([tenantId, canonicalStudentId])
  @@index([tenantId])
  @@index([tenantId, integrationVersion, integrationId])
  @@index([tenantId, integrationCreatedSequence, integrationId])
  @@map("students")
}

/// Global, append-only registry used by database triggers to prevent an
/// integration UUID from ever being reused by another source entity.
model IntegrationIdentity {
  integrationId String   @id @db.Uuid
  entityType    String
  createdAt     DateTime @default(now())

  @@map("integration_id_registry")
}

model PaymentConcept {
  id            Int       @id @default(autoincrement())
  tenantId      String    @default("colegio-conquistadores")
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  name          String
  defaultAmount Int
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  payments      Payment[]
  charges       Charge[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("payment_concepts")
}

model PaymentGroup {
  id                Int               @id @default(autoincrement())
  tenantId          String            @default("colegio-conquistadores")
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  buyOrder          String?
  authorizationCode String?
  cardLast4         String?
  totalAmount       Int
  method            PaymentMethod
  paymentDate       DateTime
  boletaFileUrl     String?
  boletaNumber      String?
  notes             String?
  source            PaymentSource     @default(MANUAL)
  isBoletaPending   Boolean           @default(false)
  payments          Payment[]
  notificationLogs  NotificationLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@unique([tenantId, buyOrder])
  @@index([tenantId])
  @@map("payment_groups")
}

model Payment {
  id          Int           @id @default(autoincrement())
  tenantId    String        @default("colegio-conquistadores")
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  amount      Int
  method      PaymentMethod
  source      PaymentSource @default(MANUAL)
  paymentDate DateTime
  studentId   Int
  student     Student       @relation(fields: [studentId], references: [id])

  paymentGroupId Int?
  paymentGroup   PaymentGroup? @relation(fields: [paymentGroupId], references: [id])

  // Concepto de pago (opcional para compatibilidad con registros anteriores)
  conceptId Int?
  concept   PaymentConcept? @relation(fields: [conceptId], references: [id])

  chargeId Int?
  charge   Charge? @relation(fields: [chargeId], references: [id])

  // Datos del pagador alternativo (null = pagó el apoderado)
  payerName String?
  payerRut  String?

  // Referencia y notas
  referenceCode String?
  notes         String?

  // Comprobante / boleta (pagos individuales legacy; agrupados usan PaymentGroup)
  boletaFileUrl String?
  boletaNumber  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@map("payments")
}

model Charge {
  id         Int            @id @default(autoincrement())
  tenantId   String         @default("colegio-conquistadores")
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  studentId  Int
  student    Student        @relation(fields: [studentId], references: [id])
  conceptId  Int
  concept    PaymentConcept @relation(fields: [conceptId], references: [id])
  /// The enrollment (student + academic year) this charge bills. The due
  /// date does not define the year: a 2027 enrollment fee may fall in 2026.
  enrollmentId Int
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id])
  amount     Int
  paidAmount Int            @default(0)
  dueDate    DateTime
  status     ChargeStatus   @default(PENDING)
  notes      String?
  payments   Payment[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  @@index([tenantId])
  @@index([enrollmentId])
  @@map("charges")
}

/// An academic year of the tenant. Académico owns years (ADR-0025); BL keeps
/// this local record to scope courses, enrollments and billing.
model AcademicYear {
  id                      Int                @id @default(autoincrement())
  tenantId                String
  tenant                  Tenant             @relation(fields: [tenantId], references: [id])
  label                   String             @db.VarChar(160)
  startDate               DateTime           @db.Date
  endDate                 DateTime           @db.Date
  status                  AcademicYearStatus @default(ACTIVE)
  /// Académico AcademicYear.id when the year is linked to the canonical one.
  canonicalAcademicYearId String?            @db.Uuid
  courses                 Course[]
  enrollments             Enrollment[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@unique([tenantId, label])
  @@unique([tenantId, canonicalAcademicYearId])
  @@index([tenantId, status])
  @@map("academic_years")
}

/// A student's enrollment in one course for one academic year. The financial
/// plan (its charges) belongs to the enrollment, so 2026 and 2027 plans of the
/// same student are independent.
model Enrollment {
  id                    Int                  @id @default(autoincrement())
  tenantId              String
  tenant                Tenant               @relation(fields: [tenantId], references: [id])
  studentId             Int
  student               Student              @relation(fields: [studentId], references: [id])
  courseId              Int
  course                Course               @relation(fields: [courseId], references: [id])
  academicYearId        Int
  academicYear          AcademicYear         @relation(fields: [academicYearId], references: [id])
  status                EnrollmentStatus     @default(ACTIVE)
  financialSetup        FinancialSetupStatus @default(PENDING)
  /// Académico CourseEnrollment.id once the projection write mode links it.
  canonicalEnrollmentId String?              @db.Uuid
  charges               Charge[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([studentId, academicYearId])
  @@unique([tenantId, canonicalEnrollmentId])
  @@index([tenantId, academicYearId, status])
  @@index([courseId])
  @@map("enrollments")
}

model NotificationLog {
  id             Int                @id @default(autoincrement())
  tenantId       String             @default("colegio-conquistadores")
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  type           NotificationType
  status         NotificationStatus @default(PENDING)
  recipientEmail String
  subject        String
  body           String
  errorMessage   String?
  retryCount     Int                @default(0)
  studentId      Int?
  student        Student?           @relation(fields: [studentId], references: [id])
  paymentGroupId Int?
  paymentGroup   PaymentGroup?      @relation(fields: [paymentGroupId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  @@index([tenantId])
  @@index([tenantId, status, retryCount])
  @@map("notification_logs")
}

model SentCommunication {
  id             String            @id @default(uuid())
  tenantId       String            @default("colegio-conquistadores")
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  recipientEmail String
  recipientName  String?
  type           CommunicationType
  subject        String
  status         DeliveryStatus
  resendEmailId  String?
  metadata       Json?
  errorMessage   String?
  createdAt      DateTime          @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, type, status])
  @@index([resendEmailId])
  @@map("sent_communications")
}

model TenantEmailConfig {
  id                        String   @id @default(uuid())
  tenantId                  String   @unique
  tenant                    Tenant   @relation(fields: [tenantId], references: [id])
  senderName                String   @default("Colegio Conquistadores")
  senderEmail               String?
  replyToEmail              String?
  emailFooter               String?
  enableAllEmails           Boolean  @default(true)
  enableManualPaymentEmails Boolean  @default(true)
  enableBoletaEmails        Boolean  @default(true)
  enableReminderEmails      Boolean  @default(true)
  updatedAt                 DateTime @updatedAt

  @@map("tenant_email_configs")
}

model User {
  id                        String                   @id @default(uuid())
  tenantId                  String?
  tenant                    Tenant?                  @relation(fields: [tenantId], references: [id])
  email                     String                   @unique
  password                  String
  name                      String
  isActive                  Boolean                  @default(true)
  roleId                    String
  role                      Role                     @relation(fields: [roleId], references: [id])
  assignedCanonicalMappings TenantCanonicalMapping[] @relation("TenantCanonicalMappingAssignedBy")
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([tenantId])
  @@map("users")
}

/// Mapea una sola vez el tenant financiero local a su tenant canónico de
/// EduPay Identity. Es una frontera entre bases de datos: no hay FK hacia
/// Identity y nunca se infiere desde slug, nombre ni desde un JWT de cliente.
model TenantCanonicalMapping {
  tenantId          String   @id
  canonicalTenantId String   @unique @db.Uuid
  assignedByUserId  String
  correlationId     String
  reason            String
  createdAt         DateTime @default(now())

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedByUser User   @relation("TenantCanonicalMappingAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([assignedByUserId])
  @@index([correlationId])
  @@map("tenant_canonical_mappings")
}

/// Read-only shadow of the audited Academic Financial Projection v1 contract.
/// It is deliberately unrelated to BL Course/Student/Charge/Payment models.
model AcademicFinancialProjection {
  id                    String                             @id @default(uuid()) @db.Uuid
  tenantId              String
  canonicalTenantId     String                             @db.Uuid
  academicYearId        String                             @db.Uuid
  academicStudentId     String                             @db.Uuid
  academicCourseId      String                             @db.Uuid
  academicEnrollmentId  String                             @db.Uuid
  enrollmentStatus      String                             @db.VarChar(16)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  version               BigInt
  sourceUpdatedAt       DateTime
  operation             AcademicFinancialProjectionOperation
  /// Contract v2 descriptors (ADR-0025). Nullable only for rows applied before v2.
  /// studentNationalId (RUN/IPE) is sensitive: never log it or return it outside
  /// the records that need it.
  studentFirstName           String?   @db.VarChar(120)
  studentLastName            String?   @db.VarChar(120)
  studentNationalIdType      String?   @db.VarChar(8)
  studentNationalId          String?   @db.VarChar(20)
  /// BL Student.integrationId when the student came from the legacy feed.
  studentLegacyIntegrationId String?   @db.VarChar(200)
  courseLabel                String?   @db.VarChar(160)
  /// BL Course.integrationId when the course came from the legacy feed.
  courseLegacyIntegrationId  String?   @db.VarChar(200)
  academicYearLabel          String?   @db.VarChar(160)
  academicYearStartDate      DateTime? @db.Date
  academicYearEndDate        DateTime? @db.Date
  academicYearStatus         String?   @db.VarChar(16)
  lastEventId           String?                            @db.Uuid
  lastSnapshotId        String?                            @db.Uuid
  /// Result of writing this row into BL's tables (write mode, ADR-0027):
  /// APPLIED, PENDING_INTAKE (new student awaiting a guardian), CONFLICT or
  /// SKIPPED. Null while the row was only shadowed.
  writeOutcome          String?                            @db.VarChar(32)
  writeReasonCode       String?                            @db.VarChar(64)
  writtenAt             DateTime?
  /// `version` of the row when it was last written; behind `version` means
  /// the row changed since and must be written again.
  writtenVersion        BigInt?
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, academicEnrollmentId])
  @@index([tenantId, studentLegacyIntegrationId])
  @@index([tenantId, courseLegacyIntegrationId])
  @@index([canonicalTenantId, academicEnrollmentId])
  @@index([tenantId, academicYearId, enrollmentStatus])
  @@index([tenantId, operation, sourceUpdatedAt])
  @@index([tenantId, writeOutcome])
  @@map("academic_financial_projections")
}

/// Append-only processing ledger. Its composite identity makes duplicate event
/// replay observable without allowing an older entity version to overwrite a newer one.
model AcademicFinancialProjectionConsumedEvent {
  producer              String                                    @default("ACADEMIC") @db.VarChar(32)
  canonicalTenantId     String                                    @map("canonical_tenant_id") @db.Uuid
  eventId               String                                    @map("event_id") @db.Uuid
  tenantId              String?
  aggregateId           String?                                   @map("aggregate_id") @db.Uuid
  entityVersion         BigInt?                                   @map("entity_version")
  outcome               AcademicFinancialProjectionEventOutcome
  reasonCode            String?                                   @map("reason_code") @db.VarChar(80)
  correlationId         String?                                   @map("correlation_id") @db.VarChar(128)
  receivedAt            DateTime                                  @default(now()) @map("received_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([producer, canonicalTenantId, eventId])
  @@index([tenantId, receivedAt])
  @@index([canonicalTenantId, aggregateId, entityVersion])
  @@map("academic_financial_projection_consumed_events")
}

/// Invalid or unrouteable source messages are retained without inferring a
/// tenant. Operators can inspect and explicitly resolve the cause later.
model AcademicFinancialProjectionQuarantine {
  id                    String   @id @default(uuid()) @db.Uuid
  producer              String   @default("ACADEMIC") @db.VarChar(32)
  canonicalTenantId     String   @map("canonical_tenant_id") @db.Uuid
  eventId               String?  @map("event_id") @db.Uuid
  reasonCode            String   @map("reason_code") @db.VarChar(80)
  correlationId         String?  @map("correlation_id") @db.VarChar(128)
  payload               Json
  resolvedAt            DateTime? @map("resolved_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@unique([producer, canonicalTenantId, eventId])
  @@index([canonicalTenantId, resolvedAt, createdAt])
  @@map("academic_financial_projection_quarantine")
}

/// Local progress for a remote snapshot. Absence is never used as a tombstone
/// until a complete source boundary has been recorded and reconciled.
model AcademicFinancialProjectionSnapshot {
  id                    String                                    @id @default(uuid()) @db.Uuid
  tenantId              String
  canonicalTenantId     String                                    @db.Uuid
  sourceSnapshotId      String                                    @db.Uuid
  sourceSnapshotToken   String                                    @db.Text
  nextCursor            String?                                   @map("next_cursor") @db.Text
  status                AcademicFinancialProjectionSnapshotStatus @default(STARTED)
  watermark             String?                                   @db.Text
  expectedItemCount     Int?                                      @map("expected_item_count")
  receivedItemCount     Int                                       @default(0) @map("received_item_count")
  startedAt             DateTime                                  @default(now()) @map("started_at")
  completedAt           DateTime?                                 @map("completed_at")
  reconciledAt          DateTime?                                 @map("reconciled_at")
  errorCode             String?                                   @map("error_code") @db.VarChar(80)
  updatedAt             DateTime                                  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, sourceSnapshotId])
  @@index([tenantId, status, startedAt])
  @@map("academic_financial_projection_snapshots")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // Ej: "ADMIN", "CONTADOR"
  description String?
  users       User[]
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  action    String   @unique // Ej: "create:payment", "view:users"
  roles     Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}
